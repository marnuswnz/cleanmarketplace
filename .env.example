# Copy to .env.local for development. Vercel: set these in Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=[BRAND]
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.co.nz
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.co.nz
NEXT_PUBLIC_LEGAL_ENTITY=[BRAND] Limited

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_STANDARD=
STRIPE_PRICE_SEAT_LARGE=
FOUNDING_TRIAL_DAYS=60

# SMS: "twilio" (default) or "clicksend"
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="[BRAND] <quotes@example.co.nz>"
ADMIN_EMAIL=

# Cron (Vercel sends "Authorization: Bearer $CRON_SECRET" automatically)
CRON_SECRET=

# Cloudflare Turnstile (site key must be public to render the widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics: set one
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Routing config (MAX_* must match app_settings in the DB, which the triggers enforce)
OFFER_TTL_MINUTES=30
MAX_PARTNERS_PER_LEAD=2
MAX_SEATS_PER_CELL=2
OVERFLOW_PRICE_CENTS=2000

# Log SMS/email to the console instead of sending (defaults to true outside production)
DRY_RUN_MESSAGES=true
